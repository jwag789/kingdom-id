# Register Cappuccino with Kingdom ID first:
#   pnpm -s kingdom clients create --name Cappuccino --first-party \
#     --redirect-uri http://localhost:4002/api/auth/callback/kingdom \
#     --post-logout-uri http://localhost:4002/
KINGDOM_ISSUER=http://localhost:4000
AUTH_KINGDOM_ID=
AUTH_KINGDOM_SECRET=
# Auth.js session encryption key: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:4002
