# Public host name; DNS must point here before Caddy can get a certificate.
ISSUER_HOST=id.example.com
ISSUER=https://id.example.com

# install.sh generates all four. By hand: the passwords with `openssl rand -hex 24`
# (they go inside connection URLs), the keys with `openssl rand -base64 32`.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
KEY_ENCRYPTION_KEY=
SERVER_SECRET=

# Email relay (see docs/email-relay.md). Without SES, set EMAIL_RELAY_ENABLED=false.
EMAIL_RELAY_ENABLED=true
RELAY_DOMAIN=relay.example.com
RELAY_TRANSPORT=ses
AWS_REGION=us-east-1
RELAY_SNS_TOPIC_ARN=
# AWS credentials for SES/S3 (an IAM user limited to the policy in docs/email-relay.md):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
