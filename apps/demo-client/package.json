{
  "name": "@kingdom-id/demo-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal relying party that signs in with Kingdom ID using an independent OIDC client library.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "fastify": "^5.6.1",
    "openid-client": "^6.8.1"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
