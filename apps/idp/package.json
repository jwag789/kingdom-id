{
  "name": "@kingdom-id/idp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:src": "tsx --conditions=development --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --conditions=development --env-file-if-exists=../../.env src/scripts/seed.ts",
    "rotate-keys": "tsx --conditions=development --env-file-if-exists=../../.env src/scripts/rotate-keys.ts",
    "make-admin": "tsx --conditions=development --env-file-if-exists=../../.env src/scripts/make-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@kingdom-id/brand": "workspace:*",
    "@kingdom-id/db": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@simplewebauthn/server": "^13.3.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "preact": "^10.27.2",
    "preact-render-to-string": "^6.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.7.1",
    "@testcontainers/redis": "^11.7.1",
    "openid-client": "^6.8.1",
    "postgres": "^3.4.7",
    "testcontainers": "^11.7.1",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
