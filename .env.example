# Copy to .env for local development: `cp .env.example .env`, then fill the
# two secrets with `openssl rand -base64 32` each.
ISSUER=http://localhost:4000
PORT=4000
DATABASE_URL=postgres://kingdom:kingdom@localhost:54320/kingdom_id
REDIS_URL=redis://localhost:63790
KEY_ENCRYPTION_KEY=
SERVER_SECRET=
LOG_LEVEL=info
# Per-app private email addresses. See docs/email-relay.md for the AWS side.
EMAIL_RELAY_ENABLED=true
# RELAY_DOMAIN=relay.localhost          # default: relay.<issuer host>
# RELAY_TRANSPORT=memory                # "ses" in production
# AWS_REGION=us-east-1
# RELAY_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:kingdom-relay

# Demo client (printed by `pnpm seed`)
DEMO_CLIENT_ID=kingdom-demo
DEMO_CLIENT_SECRET=
DEMO_PORT=4001
